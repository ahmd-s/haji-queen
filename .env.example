# Copy to .env.local and fill in real values. Never commit filled-in env files.

# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required. At least 32 characters. Used to sign admin session cookies.
AUTH_SECRET=

# Seed-only admin credentials. Do not leave defaults in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL used in metadata, sitemap and catalogue feeds.
NEXT_PUBLIC_SITE_URL=

# Shipping
NEXT_PUBLIC_SHIPPING_FEE=
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=

# Optional integrations
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LOGO_PATH=

# Local QA only: a real hq_admin_session cookie value from a signed-in admin.
QA_ADMIN_COOKIE=
