// Haji Queens — Prisma schema (SQLite for sandbox; portable to Postgres/Supabase)
// NOTE: SQLite has no native arrays/enums-as-lists, so multi-value fields are
// stored as JSON strings and parsed at the application boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (runtime)
  directUrl = env("DATABASE_URL_UNPOOLED") // Neon direct connection (schema push)
}

// ────────────────────────── Admin & Auth ──────────────────────────

model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           String    @default("ADMIN") // ADMIN | SUPER_ADMIN
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ────────────────────────── Catalogue ──────────────────────────

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  tagline       String?
  description   String?
  bannerImage   String?
  tileImage     String?
  featuredOrder Int      @default(0) // order on homepage (0 = hidden)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  products      Product[]
}

// HQ_ORIGINAL = designed by Haji Queens
// TRUSTED_SUPPLIER = sourced from a supplier catalogue (retail-branded identically)
model Product {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  description      String
  fabricDetails    String?
  careInstructions String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  source           String   @default("HQ_ORIGINAL")
  price            Float // final retail price — the ONLY price visible to customers
  compareAtPrice   Float?
  colors           String   @default("[]") // JSON: [{name, hex}]
  sizes            String   @default("[]") // JSON: ["XS","S",...]
  images           String   @default("[]") // JSON: ["/images/..."]
  sizeGuide        String? // JSON rows for size chart (optional)
  badge            String? // e.g. "New In" | "Bestseller"
  stock            Int      @default(0) // aggregate; source of truth = variants
  featured         Boolean  @default(false)
  visible          Boolean  @default(true)
  popularity       Int      @default(0)
  sku              String?  @unique
  // ── Catalogue workflow (defaults keep legacy products' behaviour unchanged) ──
  // false = selling price not yet approved: never shown or purchasable.
  priceConfirmed   Boolean  @default(true)
  // true  = purchasability follows variant stock quantities (legacy behaviour).
  // false = no quantities known; `availability` alone decides purchasability.
  trackStock       Boolean  @default(true)
  availability     String   @default("IN_STOCK") // IN_STOCK | READY_TO_DISPATCH | PRE_ORDER | UNAVAILABLE
  sizeNotes        String? // customer-facing measurements as stated by the source
  reviewNotes      String? // ADMIN ONLY — JSON [{field, note}] of unresolved items
  catalogueBatch   String? // e.g. "MASTER_V1_1" — genuine catalogue imports
  isEnquiryOnly     Boolean  @default(false)
  customSizingAllowed Boolean @default(false)
  readyToDispatch   Boolean  @default(false)
  preorderAllowed   Boolean  @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  shippingRuleId   String?
  shippingRule     ShippingRule? @relation(fields: [shippingRuleId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  variants         ProductVariant[]
  orderItems       OrderItem[]
  catalogueEntry   SupplierCatalogueEntry?
  stockMovements   StockMovement[]

  @@index([categoryId, visible, createdAt])
  @@index([visible, featured, createdAt])
}

model ProductVariant {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size             String
  color            String
  stock            Int     @default(0)
  sku              String? @unique
  extraPrice       Float   @default(0)
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)
  lowStockThreshold Int    @default(2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  stockMovements   StockMovement[]
  reservations     InventoryReservation[]
  orderItems       OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ────────────────────────── Suppliers (internal only) ──────────────────────────
// Wholesale prices, costs and margins are NEVER exposed through public APIs.

model Supplier {
  id              String   @id @default(uuid())
  name            String
  contactPerson   String?
  phone           String?
  email           String?
  catalogName     String?
  notes           String? // internal notes
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  catalogueEntries SupplierCatalogueEntry[]
}

model SupplierCatalogueEntry {
  id             String   @id @default(uuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierRef    String? // supplier's product reference
  itemName       String
  wholesalePrice Float // internal cost — restricted
  quotedPrice    Float? // supplier's quoted price — internal reference, NOT a selling price
  markupPct      Float    @default(0) // e.g. 30 = +30%
  fixedMarkup    Float    @default(0) // flat ₹ amount added
  availability   String   @default("AVAILABLE") // AVAILABLE | LOW_STOCK | OUT_OF_STOCK | DISCONTINUED
  imageUrl       String?
  notes          String? // internal notes
  productId      String?  @unique
  product        Product? @relation(fields: [productId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ────────────────────────── Customers & Orders ──────────────────────────

model Customer {
  id              String   @id @default(uuid())
  name            String
  email           String?
  emailNormalized String?
  phone           String
  phoneKey        String?  @unique // digits-only key; backfilled by migration
  consentAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]

  @@index([phone])
}

model Order {
  id            String   @id @default(uuid())
  orderNumber   String   @unique // HQ-240001 style
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String
  phone         String
  email         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  subtotal      Float
  shippingFee   Float    @default(0)
  total         Float
  status        String   @default("PENDING") // PENDING|CONFIRMED|PROCESSING|SHIPPED|DELIVERED|CANCELLED
  paymentMethod String // COD | BANK_TRANSFER | RAZORPAY
  paymentStatus String   @default("UNPAID") // UNPAID|PAID|REFUNDED|FAILED
  paymentRef    String? // gateway reference when live
  customerNote  String?
  internalNotes String?
  idempotencyKey String? @unique
  currency      String   @default("INR")
  discount      Float    @default(0)
  tax           Float    @default(0)
  carrier       String?
  trackingNumber String?
  shippingRuleId String?
  shippingRule  ShippingRule? @relation(fields: [shippingRuleId], references: [id])
  cancelledAt   DateTime?
  cancellationReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusEvent[]
  stockMovements StockMovement[]
  reservations  InventoryReservation[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  productSlug String
  imageUrl    String?
  size        String?
  color       String?
  quantity    Int
  unitPrice   Float // retail at time of purchase
  lineTotal   Float
}

// ────────────────────────── Inquiries ──────────────────────────

model MeasurementInquiry {
  id                  String   @id @default(uuid())
  fullName            String
  phone               String
  email               String?
  preferredContact    String   @default("WHATSAPP") // WHATSAPP | PHONE | EMAIL
  garmentType         String
  designNotes         String?
  colorPreference     String?
  sizingPreference    String   @default("CUSTOM") // STANDARD | CUSTOM
  standardSize        String?
  bust                String?
  waist               String?
  hips                String?
  shoulder            String?
  sleeveLength        String?
  armhole             String?
  dressLength         String?
  otherMeasurements   String?
  instructions        String?
  consultationDate    String? // ISO date (booking request, not confirmed appointment)
  consultationTime    String?
  referenceImageUrl   String?
  consent             Boolean  @default(false)
  status              String   @default("NEW") // NEW|IN_REVIEW|SCHEDULED|COMPLETED|ARCHIVED
  internalNotes       String?
  source              String? // e.g. "product:embroidered-occasion-abaya"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model ContactInquiry {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ────────────────────────── Editable site content ──────────────────────────

model SiteContent {
  key       String   @id
  value     String // JSON payload
  updatedAt DateTime @updatedAt
}

// ────────────────────────── Security & audit ──────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  metadata   String? // JSON payload
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// ────────────────────────── Commerce operations ──────────────────────────

model ShippingRule {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  flatFee       Float    @default(0)
  freeThreshold Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  products      Product[]
  orders        Order[]
}

model StockMovement {
  id         String          @id @default(uuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  delta      Int
  reason     String // PURCHASE | RESTOCK | ORDER_PLACED | ORDER_CANCELLED | MANUAL_ADJUSTMENT
  actorId    String?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([productId, createdAt])
  @@index([orderId])
}

model InventoryReservation {
  id         String         @id @default(uuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([variantId, expiresAt])
  @@index([orderId])
}

model Payment {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway             String // COD | BANK_TRANSFER | RAZORPAY
  gatewayOrderId      String?
  gatewayPaymentId    String?
  amount              Float
  currency            String   @default("INR")
  status              String   @default("PENDING") // PENDING | AUTHORIZED | CAPTURED | FAILED | REFUNDED
  method              String?
  signatureVerifiedAt DateTime?
  rawPayloadHash      String?
  failureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  refunds             Refund[]

  @@unique([gateway, gatewayOrderId])
  @@unique([gateway, gatewayPaymentId])
  @@index([orderId])
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount          Float
  reason          String?
  gatewayRefundId String?  @unique
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model OrderStatusEvent {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model MediaAsset {
  id        String   @id @default(uuid())
  key       String   @unique
  url       String
  alt       String?
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  checksum  String?
  kind      String   @default("PRODUCT")
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model WebhookEvent {
  id          String    @id // gateway event id
  gateway     String
  eventType   String
  payloadHash String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([gateway, createdAt])
}

model IdempotencyKey {
  key         String   @id
  scope       String
  requestHash String
  responseJson String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([scope, expiresAt])
}
